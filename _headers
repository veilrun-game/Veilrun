# Cloudflare Pages cache rules.
# Always revalidate code + content so a push shows up immediately instead of
# being served from a stale browser cache. (Images keep default caching — they
# get new filenames when they change, so they're safe to cache.)
/*.html
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
